<div class="registrationContainer loginContainer">
  <div  class="registrationContainer__card">
    <div class="registrationContainer__card-title">
      <h2>Inicia sesión</h2>
      <p>Escribe tus datos para comenzar.</p>
    </div>
    <div class="registrationContainer__card-form">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="field">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
        </div>

        <div class="field">
          <%= f.label "Contraseña" %><br />
          <%= f.password_field :password, autocomplete: "current-password" %>
        </div>

        <div class="actions">
          <%= f.submit "Iniciar sesión", class: "button" %>
        </div>
      <% end %>
    </div>

    <div class="sharedLinks">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>