  <div id="<%= dom_id workout %>" class="workoutCard">
    <div class="workoutCard_cover">
      <%= link_to workout do %>
        <div class="workoutCard_cover_asset" style="<%= workout_card_style(workout) %>">
        </div>
      <% end %>
    </div>
    <div class="workoutCard_title">
      <h5>
        <%= link_to workout do %>
          <%= workout.title %>
        <% end %>
      </h5>

      <p>
        <span><%= workout.duration %></span>
      </p>
    </div>
    <div  class="workoutCard_material">
      <p>
        Material:
        <%= workout.material %>
      </p>
    </div>
    <div  class="workoutCard_categories">
      <p>
        <%= workout.category %>
      </p>
    </div>
  </div>

