<%= form_with(model: workout) do |form| %>
  <% if workout.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(workout.errors.count, "error") %> prohibited this workout from being saved:</h2>

      <ul>
        <% workout.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>
  <div  class="field">
      <%= form.label "Categoría", style: "display: block" %>
        <%= form.select :category, [
        ["-", "-"],
        ["Lower Body", "Lower Body"],
        ["ABS and Core", "ABS and Core"],
        ["Full Body", "Full Body"],
        ["Glutes and Hips", "Glutes and Hips"],
        ["Upper Body", "Upper Body"]], {}, { class: 'input' } %>
    </div>

    <div  class="field">
      <%= form.label "Normal/Estreno", style: "display: block" %>
        <%= form.select :color, [
        ["Normal", "#004a37"],
        ["Estreno", "#111111"]], {}, { class: 'input' } %>
    </div>

  <div  class="field">
    <%= form.label "Duración", style: "display: block" %>
    <%= form.select :duration, [
      ["-", "-"],
      ["15min", "15min"],
      ["30min", "30min"],
      ["45min", "45min"],
      ["1 hora", "1 hora"]], {}, { class: 'input' } %>
  </div>

  <div  class="field">
    <%= form.label "Video", style: "display: block" %>
    <%= form.text_field :video_url %>
  </div>

  <div  class="field">
    <%= form.label :intensity, style: "display: block" %>
    <%= form.select :intensity, [
      ["-", "-"],
      ["Baja", "Baja"],
      ["Media", "Media"],
      ["Alta", "Alta"]], {}, { class: 'input' } %>
  </div>

  <div  class="field">
    <%= form.label :material, style: "display: block" %>
    <%= form.text_field :material %>
  </div>

  <div  class="field">
    <%= form.label :day, style: "display: block" %>
    <%= form.datetime_field :day %>
  </div>

  <div  class="field">
    <%= form.label :cover %>
    <%= form.file_field :cover %>
  </div>

  <div  class="field">
    <%= form.submit class: "button" %>
  </div>
<% end %>
