<% content_for :title, "#{@workout.title} · Fitteam" %>
<% can_watch = current_user&.can_watch? %>
<% facts = workout_facts(@workout) %>

<div class="classView">
  <div class="classView-player" id="player">
    <% if can_watch %>
      <button type="button" class="classView-start" data-video-id="<%= @workout.youtube_id || @workout.video_url %>" aria-label="Comenzar workout: <%= @workout.title %>">
        <%= workout_media(@workout, lazy: false) %>
        <span class="classView-shade"></span>
        <span class="classView-playButton"><%= site_icon(:play) %> Comenzar workout</span>
      </button>
    <% else %>
      <%= workout_media(@workout, lazy: false) %>
      <div class="classView-lock">
        <span class="classView-lockIcon"><%= site_icon(:lock) %></span>
        <h2>Esta clase es parte de los planes de Fitteam</h2>
        <p>Suscríbete para ver esta y todas las clases. Todos los planes incluyen 7 días gratis.</p>
        <div class="classView-lockActions">
          <%= link_to "Ver planes", payments_new_path, class: "button" %>
          <% unless current_user %>
            <%= link_to "Ya tengo cuenta", new_user_session_path, class: "classView-lockLink" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="classView-info">
    <div class="classView-head">
      <div>
        <% if @workout.premiere? || @workout.category_name %>
          <p class="classView-eyebrow">
            <% if @workout.premiere? %><span class="wBadge wBadge-premiere">Estreno</span><% end %>
            <% if @workout.category_name %>
              <% if (path = workout_category_path(@workout.category_name)) %>
                <%= link_to @workout.category_name, path %>
              <% else %>
                <span><%= @workout.category_name %></span>
              <% end %>
            <% end %>
          </p>
        <% end %>
        <h1><%= @workout.title %></h1>
      </div>
      <% if current_user %>
        <% if favorite_workout_ids.include?(@workout.id) %>
          <%= button_to favorite_workout_path(@workout), method: :delete, form: { data: { turbo: false }, class: "classView-favForm" }, class: "classView-fav is-active", title: "Quitar de favoritas" do %>
            <%= site_icon(:heart) %><span>En tus favoritas</span>
          <% end %>
        <% else %>
          <%= button_to favorite_workouts_path(workout_id: @workout), form: { data: { turbo: false }, class: "classView-favForm" }, class: "classView-fav", title: "Agregar a favoritas" do %>
            <%= site_icon(:heart) %><span>Guardar en favoritas</span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <ul class="classView-facts">
      <% if @workout.duration_label %>
        <li><%= site_icon(:clock) %><span>Duración</span><strong><%= @workout.duration_label %></strong></li>
      <% end %>
      <% if @workout.intensity_name %>
        <li><%= site_icon(:bolt) %><span>Intensidad</span><strong><%= @workout.intensity_name %></strong></li>
      <% end %>
      <% if @workout.day %>
        <li><%= site_icon(:calendar) %><span>En el calendario</span><strong><%= short_date(@workout.day) %></strong></li>
      <% end %>
    </ul>

    <% if @workout.materials.any? %>
      <div class="classView-material">
        <h2>Material</h2>
        <ul class="wChips">
          <% @workout.materials.each do |material| %>
            <li><%= material %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if current_user&.admin? %>
      <p class="classView-admin"><%= link_to "Editar clase", edit_admin_workout_path(@workout) %></p>
    <% end %>
  </div>
</div>

<% if @related.any? %>
  <section class="classView-related">
    <div class="workoutRow-header">
      <h2>Más clases de <%= @workout.category_name %></h2>
      <% if (path = workout_category_path(@workout.category_name)) %>
        <%= link_to path, class: "workoutRow-more" do %>Ver todas <%= site_icon(:arrow) %><% end %>
      <% end %>
    </div>
    <div class="workoutGrid">
      <%= render @related %>
    </div>
  </section>
<% end %>

<section class="classComments" id="comentarios">
  <h2>Comentarios <% if @comments.any? %><span><%= @comments.size %></span><% end %></h2>
  <% if @comments.empty? %>
    <p class="classComments-empty">Todavía no hay comentarios. ¡Cuéntanos qué te pareció esta clase!</p>
  <% end %>
  <% @comments.each do |comment| %>
    <article class="classComment">
      <span class="classComment-avatar"><%= comment_initials(comment) %></span>
      <div class="classComment-body">
        <p class="classComment-meta"><strong><%= comment.author_name %></strong> · <%= short_date(comment.created_at) %></p>
        <p class="classComment-text"><%= comment.text %></p>
        <% comment.replies.sort_by(&:created_at).each do |reply| %>
          <div class="classComment-reply">
            <p class="classComment-meta"><strong>Ana Gaby respondió</strong> · <%= short_date(reply.created_at) %></p>
            <p class="classComment-text"><%= reply.text %></p>
          </div>
        <% end %>
      </div>
    </article>
  <% end %>
  <% if current_user %>
    <%= form_with(model: Comment.new, url: workout_comments_path(@workout), class: "classComments-form", data: { turbo: false }) do |form| %>
      <%= form.label :text, "Escribe un comentario", class: "sr-only" %>
      <%= form.text_area :text, required: true, rows: 3, placeholder: "¿Qué te pareció la clase? ¿Tienes alguna duda para Ana Gaby?" %>
      <%= form.submit "Publicar comentario", class: "button" %>
    <% end %>
  <% else %>
    <p class="classComments-empty"><%= link_to "Inicia sesión", new_user_session_path %> para comentar.</p>
  <% end %>
</section>

<script>
  // Reproduce el video de YouTube en la misma página, en lugar de la portada.
  document.addEventListener("click", function (event) {
    var start = event.target.closest(".classView-start");
    if (!start) return;
    var iframe = document.createElement("iframe");
    iframe.src = "https://www.youtube.com/embed/" + encodeURIComponent(start.dataset.videoId) + "?autoplay=1&rel=0&modestbranding=1";
    iframe.title = start.getAttribute("aria-label");
    iframe.setAttribute("allow", "autoplay; fullscreen; picture-in-picture; encrypted-media");
    iframe.setAttribute("allowfullscreen", "");
    start.replaceWith(iframe);
  });
</script>
