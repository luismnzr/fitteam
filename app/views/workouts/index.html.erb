<% content_for :title, "Workouts" %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.css">
  <script src="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.js"></script>
<% end %>

<div class="explore">
  <section class="exploreHero">
    <div class="swiper swiper7">
      <div class="swiper-wrapper">
        <% @workoutsFeatured.each_with_index do |workout, index| %>
          <div class="swiper-slide">
            <div class="heroSlide">
              <%= workout_media(workout, css: "heroSlide-media", lazy: index.positive?) %>
              <div class="heroSlide-shade"></div>
              <div class="heroSlide-content">
                <p class="heroSlide-eyebrow">
                  <% if workout.premiere? %><span class="wBadge wBadge-premiere">Estreno</span><% end %>
                  <span>Del calendario<%= " · #{short_date(workout.day)}" if workout.day %></span>
                </p>
                <h1><%= workout.title %></h1>
                <% facts = workout_facts(workout) %>
                <% if facts.any? %>
                  <ul class="wChips wChips-light">
                    <% facts.each do |fact| %><li><%= fact %></li><% end %>
                  </ul>
                <% end %>
                <%= link_to workout, class: "homeBtn homeBtn-primary" do %><%= site_icon(:play) %> Ver clase<% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="swiper-pagination swiper-pagination7"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </section>

  <section class="exploreSection homeReveal">
    <div class="exploreWeek-header">
      <div>
        <h2>¡Entrenamiento con rutinas diarias!</h2>
        <p>Entrena diferentes grupos musculares cada dia de la semana, esto te proporciona un entrenamiento completo de todos los músculos de tu cuerpo, no tienes que hacer más ¡Ya esta todo organizado!</p>
      </div>
      <%= link_to calendario_path, class: "homeBtn exploreBtn-green" do %><%= site_icon(:calendar) %> Calendario de Clases<% end %>
    </div>
    <div class="exploreWeek-grid">
      <%= link_to image_tag("lunes.webp", alt: "Lunes: Lower Body", loading: "lazy"), lowerbody_path %>
      <%= link_to image_tag("martes.webp", alt: "Martes: Upper Body", loading: "lazy"), upperbody_path %>
      <%= link_to image_tag("miercoles.webp", alt: "Miércoles: Abs and Core", loading: "lazy"), abscore_path %>
      <%= link_to image_tag("jueves.webp", alt: "Jueves: Glutes and Hips", loading: "lazy"), gluteships_path %>
      <%= link_to image_tag("viernes.webp", alt: "Viernes: Full Body", loading: "lazy"), fullbody_path %>
    </div>
  </section>

  <% [
    [ "Lower Body", @workoutLowerBody, lowerbody_path ],
    [ "Upper Body", @workoutUpperBody, upperbody_path ],
    [ "ABS and Core", @workoutAbsCore, abscore_path ],
    [ "Glutes and Hips", @workoutGlutesHips, gluteships_path ],
    [ "Full Body", @workoutFullBody, fullbody_path ],
    [ "15/30 min", @workout1530, short_1530_path ],
    [ "Strength", @workoutStrength, strength_path ]
  ].each do |title, workouts, path| %>
    <% next if workouts.empty? %>
    <section class="exploreSection exploreRow homeReveal">
      <div class="exploreRow-header">
        <h2><%= title %></h2>
        <%= link_to path, class: "exploreRow-more" do %>Ver todas <%= site_icon(:arrow) %><% end %>
      </div>
      <div class="exploreRow-swiper">
        <div class="swiper">
          <div class="swiper-wrapper">
            <% workouts.each do |workout| %>
              <div class="swiper-slide"><%= render workout %></div>
            <% end %>
          </div>
          <div class="swiper-pagination"></div>
        </div>
        <button type="button" class="exploreRow-nav exploreRow-prev" aria-label="Anteriores"><%= site_icon(:arrow) %></button>
        <button type="button" class="exploreRow-nav exploreRow-next" aria-label="Siguientes"><%= site_icon(:arrow) %></button>
      </div>
    </section>
  <% end %>

  <section class="exploreSection homeReveal">
    <div class="exploreFilter">
      <div class="exploreFilter-header">
        <div>
          <h2>Busca un workout a tu medida</h2>
          <p>Usa los filtros para comenzar a buscar, los filtros que actives se mostrarán abajo</p>
        </div>
        <%= link_to favorites_path, class: "homeBtn homeBtn-outline" do %><%= site_icon(:heart) %> Ver Mis favoritas<% end %>
      </div>
      <form action="/all" method="GET" class="exploreFilter-form">
        <label class="exploreFilter-field">
          <span>Intensidad</span>
          <select name="intensidad">
            <option value="">Todas</option>
            <% Workout::INTENSITIES.reverse_each do |value| %><option value="<%= value %>"><%= value %></option><% end %>
          </select>
        </label>
        <label class="exploreFilter-field">
          <span>Grupo muscular</span>
          <select name="categoria">
            <option value="">Todos</option>
            <% Workout::CATEGORIES.each do |value| %><option value="<%= value %>"><%= value %></option><% end %>
          </select>
        </label>
        <label class="exploreFilter-field">
          <span>Duración</span>
          <select name="duracion">
            <option value="">Todas</option>
            <% Workout::DURATIONS.each do |value| %><option value="<%= value %>"><%= value %></option><% end %>
          </select>
        </label>
        <button type="submit" class="homeBtn homeBtn-light">Buscar workout <%= site_icon(:arrow) %></button>
      </form>
    </div>
  </section>
</div>

<script>
  // Banner de destacados.
  new Swiper(".swiper7", {
    loop: true,
    slidesPerView: 1,
    autoplay: { delay: 6000, disableOnInteraction: true },
    pagination: { el: ".swiper-pagination7", clickable: true },
    navigation: { nextEl: ".swiper7 .swiper-button-next", prevEl: ".swiper7 .swiper-button-prev" }
  });

  // Filas del catálogo: en celular se asoma la siguiente tarjeta.
  document.querySelectorAll(".exploreRow-swiper").forEach(function (row) {
    new Swiper(row.querySelector(".swiper"), {
      slidesPerView: 1.15,
      spaceBetween: 16,
      breakpoints: {
        750: { slidesPerView: 2.2, spaceBetween: 24 },
        990: { slidesPerView: 3, spaceBetween: 28 },
        1280: { slidesPerView: 4, spaceBetween: 28 }
      },
      pagination: { el: row.querySelector(".swiper-pagination"), clickable: true },
      navigation: { nextEl: row.querySelector(".exploreRow-next"), prevEl: row.querySelector(".exploreRow-prev") }
    });
  });
</script>
