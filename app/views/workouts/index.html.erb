<% content_for :title, "Workouts" %>

<div class="workoutBanner">
  <div class="swiper swiper7">
    <div class="swiper-wrapper">
      <% @workoutsFeatured.each do |workout| %>
        <div class="swiper-slide">
          <% if workout.cover.attached? %>
            <div class="workouts_banner" style="background-image: url('<%= rails_blob_url(workout.cover) %>')">
              <div class="workouts_banner_container">
                <h1><%= workout.title %></h1>
                <br>
                <p><%= workout.duration %></p>
                <br>
                <p>Intensidad: <%= workout.intensity %></p>
                <br>
                <p>Material: <%= workout.material %></p>
                <br>
                <%= link_to "Ir a workout", workout, class: "button" %>
              </div>
            </div>
          <% else %>
            <div class="workouts_banner">
              <div class="workouts_banner_container">
                <h1><%= workout.title %></h1>
                <br>
                <p><%= workout.duration %></p>
                <br>
                <p>Intensidad: <%= workout.intensity %></p>
                <br>
                <%= link_to "Ir a workout", workout, class: "button" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
    <div class="swiper-pagination swiper-pagination7"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</div>


<div class="calendarBlock">
  <div class="calendarBlock-header">
    <div class="calendarBlock-header-info">
      <h2>¡Entrenamiento con rutinas diarias!</h2>
      <br>
      <p>Entrena diferentes grupos musculares cada dia de la semana, esto te proporciona un entrenamiento completo de todos los músculos de tu cuerpo, no tienes que hacer más ¡Ya esta todo organizado!</p>
    </div>
    <div>
            <%= link_to "Calendario de Clases", calendario_path, class: "button button-green" %>
    </div>
  </div>
  <div class="calendarBlock-grid">
    <div class="calendarBlock-grid-item"><%= link_to lowerbody_path do %><%= image_tag("lunes.png") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to upperbody_path do %><%= image_tag("martes.png") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to abscore_path do %><%= image_tag("miercoles.png") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to gluteships_path do %><%= image_tag("jueves.png") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to fullbody_path do %><%= image_tag("viernes.png") %><% end %></div>
  </div>
</div>

<div class="workoutRow">

  <div class="workoutRow-header">
    <h1>Lower Body</h1>
    <%= link_to "Ver todas", lowerbody_path, class: "button" %>

  </div>
  <br>
  <div class="workoutSwiper">
      <div class="swiper swiper2">
        <div class="swiper-wrapper">
          <% @workoutLowerBody.each do |workout| %>
            <div  class="swiper-slide">
              <%= render workout %>

            </div>
          <% end %>
        </div>
        <div class="swiper-pagination swiper-pagination2"></div>
