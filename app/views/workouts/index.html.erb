<div class="filterBox">
  <div class="filterBox-header">
    <div>
      <h2>Busca un workout a tu medida</h2>
      <p>Usa los filtros para comenzar a buscar, los filtros que actives se mostrarán abajo</p>
    </div>
    <div>
      <%= link_to "Ver Mis favoritas", favorites_path, class: 'button button-clear' %>
    </div>
  </div>
  <form action="/all" method="GET">
    <div  class="filterBox-search">
      <div class="filterBox-search_columns">
          <select name="intensidad">
            <option value="">Intensidad</option>
            <option value="Alta">Alta</option>
            <option value="Media">Media</option>
            <option value="Baja">Baja</option>
          </select>
          <select name="categoria">
            <option value="">Grupo Muscular</option>
            <option value="Lower Body">Lower Body</option>
            <option value="ABS and Core">ABS and Core</option>
            <option value="Full Body">Full Body</option>
            <option value="Glutes and Hips">Glutes and Hips</option>
            <option value="Upper Body">Upper Body</option>
          </select>
          <select  name="duracion">
            <option value="">Duración</option>
            <option value="15min">15min</option>
            <option value="30min">30min</option>
            <option value="45min">45min</option>
            <option value="1 hora">1 hora</option>
          </select>
      </div>
      <div  class="filterBox-search_field">
        <input type="submit" value="Buscar workout" class="button button-white">
      </div>
    </div>
  </form>
</div>

<script>
  // Banner de destacados.
  new Swiper(".swiper7", {
    loop: true,
    slidesPerView: 1,
    autoplay: { delay: 6000, disableOnInteraction: true },
    pagination: { el: ".swiper-pagination7", clickable: true },
    navigation: { nextEl: ".swiper7 .swiper-button-next", prevEl: ".swiper7 .swiper-button-prev" }
  });

  // Filas del catálogo: en celular se asoma la siguiente tarjeta.
  document.querySelectorAll(".workoutRow .swiper").forEach(function (el) {
    new Swiper(el, {
      slidesPerView: 1.15,
      spaceBetween: 16,
      breakpoints: {
        750: { slidesPerView: 2.2, spaceBetween: 24 },
        990: { slidesPerView: 3, spaceBetween: 32 }
      },
      pagination: { el: el.querySelector(".swiper-pagination"), clickable: true },
      navigation: { nextEl: el.querySelector(".swiper-button-next"), prevEl: el.querySelector(".swiper-button-prev") }
    });
  });
</script>
