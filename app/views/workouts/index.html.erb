<% content_for :title, "Workouts" %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.css">
  <script src="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.js"></script>
<% end %>

<div class="workoutBanner">
  <div class="swiper swiper7">
    <div class="swiper-wrapper">
      <% @workoutsFeatured.each_with_index do |workout, index| %>
        <div class="swiper-slide">
          <div class="heroSlide">
            <%= workout_media(workout, css: "heroSlide-media", lazy: index.positive?) %>
            <div class="heroSlide-shade"></div>
            <div class="heroSlide-content">
              <p class="heroSlide-eyebrow">
                <% if workout.premiere? %><span class="wBadge wBadge-premiere">Estreno</span><% end %>
                <span>Del calendario<%= " · #{short_date(workout.day)}" if workout.day %></span>
              </p>
              <h1><%= workout.title %></h1>
              <% facts = workout_facts(workout) %>
              <% if facts.any? %>
                <ul class="wChips wChips-light">
                  <% facts.each do |fact| %><li><%= fact %></li><% end %>
                </ul>
              <% end %>
              <%= link_to workout, class: "button heroSlide-cta" do %><%= site_icon(:play) %> Ver clase<% end %>
            </div>
          </div>
        </div>
      <% end %>

    </div>
    <div class="swiper-pagination swiper-pagination7"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</div>


<div class="calendarBlock">
  <div class="calendarBlock-header">
    <div class="calendarBlock-header-info">
      <h2>¡Entrenamiento con rutinas diarias!</h2>
      <br>
      <p>Entrena diferentes grupos musculares cada dia de la semana, esto te proporciona un entrenamiento completo de todos los músculos de tu cuerpo, no tienes que hacer más ¡Ya esta todo organizado!</p>
    </div>
    <div>
            <%= link_to "Calendario de Clases", calendario_path, class: "button button-green" %>
    </div>
  </div>
  <div class="calendarBlock-grid">
    <div class="calendarBlock-grid-item"><%= link_to lowerbody_path do %><%= image_tag("lunes.webp", alt: "Lunes: Lower Body", loading: "lazy") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to upperbody_path do %><%= image_tag("martes.webp", alt: "Martes: Upper Body", loading: "lazy") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to abscore_path do %><%= image_tag("miercoles.webp", alt: "Miércoles: Abs and Core", loading: "lazy") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to gluteships_path do %><%= image_tag("jueves.webp", alt: "Jueves: Glutes and Hips", loading: "lazy") %><% end %></div>
    <div class="calendarBlock-grid-item"><%= link_to fullbody_path do %><%= image_tag("viernes.webp", alt: "Viernes: Full Body", loading: "lazy") %><% end %></div>
  </div>
</div>

<div class="workoutRow">

  <div class="workoutRow-header">
    <h1>Lower Body</h1>
    <%= link_to lowerbody_path, class: "workoutRow-more" do %>Ver todas <%= site_icon(:arrow) %><% end %>

  </div>
  <br>
  <div class="workoutSwiper">
      <div class="swiper swiper2">
        <div class="swiper-wrapper">
          <% @workoutLowerBody.each do |workout| %>
            <div  class="swiper-slide">
              <%= render workout %>

            </div>
          <% end %>
        </div>
        <div class="swiper-pagination swiper-pagination2"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
  </div>
</div>

