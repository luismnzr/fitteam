<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fitteam" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="turbo-visit-control" content="reload">
    <meta name="theme-color" content="#f9f8f3">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,900;1,400&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <script>

      document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
          initialView: 'dayGridMonth',
          events: "/workouts.json",
          weekends: false
        });
        calendar.render();

      });

    </script>
  </head>
  <body>
    <script
      src="https://code.jquery.com/jquery-3.4.1.min.js"
      integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo="
      crossorigin="anonymous"></script>
    <header class="header">
      <div class="header-container">
        <div class="header-container_logo">
          <%= link_to root_path do %>
              <%= image_tag("fitteam_icon.svg", class: "header_icon") %>
          <% end %>
        </div>
        <div class="header-container_actions" id="header_actions">
          <%= link_to "Explorar clases", workouts_path %>
          <%= link_to "Acerca", acerca_path %>
          <% if current_user %>
            <% unless current_user.active? %>
              <%= link_to "Planes", payments_new_path %>
            <% end %>
            <%= link_to "Favoritas", favorites_path %>
            <%= link_to "Mi Cuenta", edit_user_registration_path %>
          <% else %>
            <%= link_to "Planes", payments_new_path %>
            <%= link_to "Inicia Sesión", new_user_session_path, class: "button button-header_alpha" %>
          <% end %>
          <a href="javascript:void(0);" class="menu_icon" onclick="openMenu()">
              <%= image_tag("menu_icon.svg") %>
          </a>
        </div>
      </div>
    </header>
    <%= yield %>
    <footer>
      <div  class="footer-container">
        <div class="footer-column">
          <%= link_to root_path do %>
            <%= image_tag("fitteam_logo.svg", class: "footer_icon") %>
          <% end %>
        </div>
        <div class="footer-column">
          <div class="footer-column_list">
            <h5>Clases</h5>
            <%= link_to "Ver workouts", root_path %>
            <%= link_to "Calendario", root_path %>
            <%= link_to "Categorías", root_path %>
          </div>
          <div class="footer-column_list">
            <h5>Acerca</h5>
            <%= link_to "Acerca de", acerca_path %>
            <%= link_to "Preguntas Frecuentes", root_path %>
            <% if current_user %>
            <% else %>
            <%= link_to "Planes", payments_new_path %>
            <% end %>
          </div>
          <div class="footer-column_list">
            <h5>Legal</h5>
            <%= link_to "Términos y Condiciones", root_path %>
          </div>
        </div>
      </div>
    </footer>
    <script>
      function openMenu() {
        var x = document.getElementById("header_actions");
        if (x.className === "header-container_actions") {
          x.className += " responsive";
        } else {
          x.className = "header-container_actions";
        }
      }
    </script>
  </body>
</html>
