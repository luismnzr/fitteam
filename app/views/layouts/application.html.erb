<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Fitteam" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="turbo-visit-control" content="reload">
    <meta name="theme-color" content="#f9f8f3">

    

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="title" content="Fitteam - Entrena desde casa » Ana Gaby Fit Team" />
    <meta name="description" content="Entrenadora personal y grupal, en línea o presencial, todas mis clases te llevan un mismo nivel de exigencia personal. " />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://anagabyfitteam.com/" />
    <meta property="og:title" content="Fitteam - Entrena desde casa » Ana Gaby Fit Team" />
    <meta property="og:description" content="Entrenadora personal y grupal, en línea o presencial, todas mis clases te llevan un mismo nivel de exigencia personal. " />
    <meta property="og:image" content="<%= root_url %>og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://anagabyfitteam.com/" />
    <meta property="twitter:title" content="Fitteam - Entrena desde casa » Ana Gaby Fit Team" />
    <meta property="twitter:description" content="Entrenadora personal y grupal, en línea o presencial, todas mis clases te llevan un mismo nivel de exigencia personal. " />
    <meta property="twitter:image" content="<%= root_url %>og-image.jpg" />

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,900;1,400&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if notice.present? %>
      <p class="notification"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="notification"><%= alert %></p>
    <% end %>
    <header class="siteHeader" id="site_header">
      <div class="siteHeader-container">
        <%= link_to root_path, class: "siteHeader-logo", "aria-label": "Fitteam, inicio" do %>
          <%= image_tag("fitteam_icon.svg", alt: "") %>
        <% end %>
        <button type="button" class="siteHeader-toggle" aria-label="Menú" aria-expanded="false" aria-controls="site_nav" onclick="toggleMenu(this)">
          <span></span><span></span>
        </button>
        <nav class="siteHeader-nav" id="site_nav">
          <div class="siteHeader-links">
            <%= site_nav_link "Explorar clases", workouts_path %>
            <% if current_user %>
              <% unless current_user.active? %>
                <%= site_nav_link "Planes", payments_new_path %>
              <% end %>
              <%= site_nav_link "Calendario", calendario_path %>
              <%= site_nav_link "Favoritas", favorites_path %>
              <%= site_nav_link "Mi Cuenta", edit_user_registration_path %>
              <% if current_user.admin? %>
                <%= site_nav_link "Admin", admin_root_path %>
              <% end %>
            <% else %>
              <%= site_nav_link "Acerca", acerca_path %>
              <%= site_nav_link "Planes", payments_new_path %>
            <% end %>
          </div>
          <% if !current_user %>
            <%= link_to "Inicia Sesión", new_user_session_path, class: "siteBtn" %>
          <% elsif current_user.admin? %>
            <%= link_to "Agregar clase", new_admin_workout_path, class: "siteBtn" %>
          <% end %>
        </nav>
      </div>
    </header>
    <%= yield %>
    <footer class="siteFooter">
      <div class="siteFooter-container">
        <div class="siteFooter-brand">
          <%= link_to root_path, "aria-label": "Fitteam, inicio" do %>
            <%= image_tag("fitteam_logo.svg", alt: "Fitteam", class: "siteFooter-logo") %>
          <% end %>
          <p>Workouts para mente, cuerpo y corazón</p>
        </div>
        <nav class="siteFooter-columns" aria-label="Pie de página">
          <div>
            <h5>Clases</h5>
            <%= link_to "Ver workouts", workouts_path %>
            <%= link_to "Calendario", calendario_path %>
            <%= link_to "Filtros", all_path %>
          </div>
          <div>
            <h5>Acerca</h5>
            <%= link_to "Acerca de", acerca_path %>
            <% unless current_user %>
              <%= link_to "Planes", payments_new_path %>
            <% end %>
          </div>
          <div>
            <h5>Legal</h5>
            <%= link_to "Términos y Condiciones", terminos_path %>
          </div>
          <div class="siteFooter-contact">
            <h5>Contacto</h5>
            <%= mail_to "anagaby.fitteam@gmail.com" %>
          </div>
        </nav>
      </div>
      <div class="siteFooter-bottom">
        <span>© <%= Date.current.year %> Fitteam</span>
      </div>
    </footer>
    <script>
      function toggleMenu(button) {
        var open = document.getElementById("site_header").classList.toggle("is-open");
        button.setAttribute("aria-expanded", open);
      }
    </script>
  </body>
</html>
