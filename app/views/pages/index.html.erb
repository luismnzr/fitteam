<div class="home">
  <section class="homeHero">
    <%= video_tag "video.mp4", type: "video/mp4", poster: image_path("video_poster.jpg"), autoplay: true, loop: true, muted: true, playsinline: true, class: "homeHero-video" %>
    <div class="homeHero-content">
      <h1>WORKOUT</h1>
      <p>Para mente, cuerpo y corazón</p>
      <%= link_to workouts_path, class: "homeBtn homeBtn-primary" do %>
        Comenzar un workout <%= site_icon(:arrow) %>
      <% end %>
    </div>
  </section>

  <section class="homeSection homeReveal">
    <div class="homeAmbassador">
      <div class="homeAmbassador-photo">
        <%= image_tag "embassador_cover.jpg", alt: "Ana Gaby Ornelas" %>
      </div>
      <div class="homeAmbassador-info">
        <h2>Ana Gaby Ornelas</h2>
        <p>
          Entrenadora personal y grupal, en línea o presencial, todas mis clases te llevan un mismo nivel de exigencia personal. Apasionada y entregada a esto que llamo trabajo, ayudarte a construir tu mejor versión y trabajar diario en ello es mi objetivo principal.
        </p>
        <p>
          Con certificaciones en diferentes disciplinas he creado mi propio método de entrenamiento que te ayuda a fortalecer y tonificar de una forma muy dinámica y divertida. Te invito a conocerme un poquito más probando lo que prepare especialmente para ti en esta plataforma.
        </p>
        <div class="homeAmbassador-badge">
          <%= image_tag "lululemon.png", alt: "lululemon" %>
          <span>CITY AMBASSADOR</span>
        </div>
      </div>
    </div>
  </section>

  <% @workouts.each do |workout| %>
    <section class="homeSection homeReveal">
      <%= link_to workout, class: "homeWotd" do %>
        <div class="homeWotd-info">
          <span class="homeEyebrow">Workout del día</span>
          <h2><%= workout.title %></h2>
          <% if (facts = workout_facts(workout)).any? %>
            <ul class="wChips wChips-light">
              <% facts.each do |fact| %><li><%= fact %></li><% end %>
            </ul>
          <% end %>
          <p>Rutina del dia de hoy, realiza tu ejercicio en el horario que mas quieras.</p>
          <span class="homeBtn homeBtn-light">Ir a workout <%= site_icon(:arrow) %></span>
        </div>
        <div class="homeWotd-cover">
          <%= workout_media(workout, lazy: false) %>
          <span class="wBadge homeWotd-today">Hoy</span>
          <span class="homeWotd-play"><%= site_icon(:play) %></span>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="homeSection homeReveal">
    <div class="homeStats">
      <div class="homeStats-info">
        <h2>¡Entrenamiento con rutinas diarias que te ayudarán a lograr tus objetivos!</h2>
        <p>Inscríbete a mi programa de entrenamiento y podrás entrenar conmigo donde quiera que te encuentres, ya sea en un gimnasio o desde tu casa. Todos los días subo contenido nuevo que te ayudará a mantenerte en forma.</p>
      </div>
      <dl class="homeStats-numbers">
        <div><dt>+450</dt><dd>Videos</dd></div>
        <div><dt>+300</dt><dd>Usuarios</dd></div>
        <div><dt>5</dt><dd>Grupos Musculares</dd></div>
      </dl>
      <div class="homeStats-cover" role="img" aria-label="Entrenamiento en casa"></div>
    </div>
  </section>

  <% unless current_user&.active? %>
    <%= render "payments/plans" %>
  <% end %>

  <section class="homeSection homeReveal">
    <div class="homeCta">
      <h2>Workouts para mente, cuerpo y corazón</h2>
      <div class="homeCta-actions">
        <% if current_user %>
          <%= link_to "Ir a clases", workouts_path, class: "homeBtn homeBtn-light" %>
          <%= link_to "Mi cuenta", edit_user_registration_path, class: "homeBtn homeBtn-outline" %>
        <% else %>
          <%= link_to "Inicia sesión", new_user_session_path, class: "homeBtn homeBtn-light" %>
          <%= link_to "Crear cuenta", new_user_registration_path, class: "homeBtn homeBtn-outline" %>
        <% end %>
      </div>
    </div>
  </section>
</div>
